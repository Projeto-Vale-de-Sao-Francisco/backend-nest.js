        {
          "name": "[200, cache] Repetir atualização",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/mercado/atualizar",
              "host": ["{{baseUrl}}"],
              "path": ["mercado", "atualizar"]
            },
            "description": "Execute imediatamente após uma atualização bem-sucedida, dentro do TTL e sem reiniciar a API. Falha anterior não publica cache.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cultura_id\": {{culturaId}},\n  \"fonte\": \"comexstat\",\n  \"forcar\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Comex Stat em cache, sem nova gravação', function () {",
                  "    const fonte = pm.response.json().fontes.find(item => item.id === 'comexstat');",
                  "    pm.expect(fonte).to.be.an('object'); pm.expect(fonte.status).to.eql('cache'); pm.expect(fonte.registros_gravados).to.eql(0);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
