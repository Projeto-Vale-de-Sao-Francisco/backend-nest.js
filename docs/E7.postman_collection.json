      "type": "string"
    },
    {
      "key": "adminSenha",
      "value": "",
      "type": "string"
    },
    {
      "key": "comumEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "comumSenha",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenComum",
      "value": "",
      "type": "string"
    },
