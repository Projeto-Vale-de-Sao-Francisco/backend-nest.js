  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "[200] Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Usa usuário admin existente e ATIVO. Postman salva accessToken em token. No Thunder Client, se scripts pm.* não rodarem, copie accessToken da resposta e preencha manualmente token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test('accessToken presente', function () { pm.expect(data.accessToken).to.be.a('string').and.not.empty; });",
                  "  if (typeof data.accessToken === 'string' && data.accessToken) pm.collectionVariables.set('token', data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "[200] Login comum",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
