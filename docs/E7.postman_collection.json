                  "  pm.test('accessToken presente', function () { pm.expect(data.accessToken).to.be.a('string').and.not.empty; });",
                  "  if (typeof data.accessToken === 'string' && data.accessToken) pm.collectionVariables.set('tokenComum', data.accessToken);",
                  "}"
