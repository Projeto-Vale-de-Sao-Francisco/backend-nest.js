generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Substitui caso utilizes outro banco
  url      = env("DATABASE_URL")
}

model Permissao {
  id        Int                 @id @default(autoincrement())
  chave     String
  descricao String?
  
  usuarios  Usuario_Permissao[]
}

model Usuario_Permissao {
  usuario_id    Int
  permissao_id  Int
  concedido_por Int
  concedido_em  DateTime @default(now())

  usuario   Usuario   @relation("PossuiPermissao", fields: [usuario_id], references: [id])
  permissao Permissao @relation(fields: [permissao_id], references: [id])
  concessor Usuario   @relation("ConcedePermissao", fields: [concedido_por], references: [id])

  @@id([usuario_id, permissao_id])
}

model Usuario {
  id         Int      @id @default(autoincrement())
  nome       String
  cpf        String   @unique
  email      String   @unique
  senha_hash String
  telefone   String?
  perfil     String
  status     String
  created_at DateTime @default(now())

  permissoes           Usuario_Permissao[]   @relation("PossuiPermissao")
  permissoesConcedidas Usuario_Permissao[]   @relation("ConcedePermissao")
  logs                 Audit_Log[]
  empresas             Usuario_Empresa[]
  propriedades         Usuario_Propriedade[]
}

model Audit_Log {
  id           Int      @id @default(autoincrement())
  usuario_id   Int?     
  acao         String
  recurso      String
  recurso_id   String?
  ip_origem    String?
  dados_antes  Json?    
  dados_depois Json?
  criado_em    DateTime @default(now())

  usuario Usuario? @relation(fields: [usuario_id], references: [id])
}

model Usuario_Empresa {
  id            Int      @id @default(autoincrement())
  usuario_id    Int
  empresa_id    Int
  papel_empresa String
  data_vinculo  DateTime
  status        String

  usuario Usuario @relation(fields: [usuario_id], references: [id])
  empresa Empresa @relation(fields: [empresa_id], references: [id])

  // Evita vínculos duplicados entre o mesmo utilizador e empresa
  @@unique([usuario_id, empresa_id])
}

model Empresa {
  id            Int      @id @default(autoincrement())
  razao_social  String
  nome_fantasia String?
  cpf_cnpj      String   @unique
  telefone      String?
  email         String?
  tipo          String
  status        String

  usuarios            Usuario_Empresa[]
  propriedades        Propriedade[]
  operacoes_logistica Operacao_Logistica[]
}

model Usuario_Propriedade {
  id             Int      @id @default(autoincrement())
  usuario_id     Int
  propriedade_id Int
  papel_vinculo  String
  data_vinculo   DateTime
  status         String

  usuario     Usuario     @relation(fields: [usuario_id], references: [id])
  propriedade Propriedade @relation(fields: [propriedade_id], references: [id])

  // Evita vínculos duplicados entre o mesmo utilizador e propriedade
  @@unique([usuario_id, propriedade_id])
}

model Propriedade {
  id         Int     @id @default(autoincrement())
  empresa_id Int
  nome       String
  municipio  String
  estado     String
  latitude   Float?
  longitude  Float?
  area_total Float
  status     String

  empresa  Empresa               @relation(fields: [empresa_id], references: [id])
  usuarios Usuario_Propriedade[]
  talhoes  Talhao[]

  // Índice para otimizar consultas de propriedades por empresa
  @@index([empresa_id])
}

model Talhao {
  id             Int     @id @default(autoincrement())
  propriedade_id Int
  nome           String
  area           Float
  latitude       Float?
  longitude      Float?
  status         String

  propriedade  Propriedade      @relation(fields: [propriedade_id], references: [id])
  culturas     Talhao_Cultura[]
  dispositivos Dispositivo[]

  // Índice para otimizar consultas de talhões por propriedade
  @@index([propriedade_id])
}

model Cultura {
  id               Int     @id @default(autoincrement())
  nome             String
  variedade        String?
  temperatura_min  Float?
  temperatura_max  Float?
  umidade_min      Float?
  umidade_max      Float?
  ciclo_medio_dias Int?
  descricao        String?

  talhoes         Talhao_Cultura[]
  valores_mercado Valor_Mercado[]
}

model Talhao_Cultura {
  id           Int      @id @default(autoincrement())
  talhao_id    Int
  cultura_id   Int
  data_plantio DateTime
  status       String

  talhao                   Talhao                    @relation(fields: [talhao_id], references: [id])
  cultura                  Cultura                   @relation(fields: [cultura_id], references: [id])
  recomendacoes_exportacao Recomendacao_Exportacao[]
  recomendacoes_colheita   Recomendacao_Colheita[]
  colheitas                Colheita[]
}

model Valor_Mercado {
  id               Int      @id @default(autoincrement())
  cultura_id       Int
  data_referencia  DateTime
  mercado_destino  String
  pais_destino     String
  preco            Decimal  // Alterado de Float para Decimal para valores monetários
  moeda            String
  unidade_medida   String
  demanda_estimada Float?

  cultura                  Cultura                   @relation(fields: [cultura_id], references: [id])
  recomendacoes_exportacao Recomendacao_Exportacao[]

  // Índice para otimizar o histórico e consultas de mercado
  @@index([cultura_id, data_referencia])
}

model Recomendacao_Exportacao {
  id                  Int       @id @default(autoincrement())
  talhao_cultura_id   Int
  valor_mercado_id    Int
  data_geracao        DateTime
  inicio_janela       DateTime?
  fim_janela          DateTime?
  destino_recomendado String
  score               Float?
  justificativa       String?

  talhao_cultura Talhao_Cultura @relation(fields: [talhao_cultura_id], references: [id])
  valor_mercado  Valor_Mercado  @relation(fields: [valor_mercado_id], references: [id])
}

model Recomendacao_Colheita {
  id                Int       @id @default(autoincrement())
  talhao_cultura_id Int
  data_geracao      DateTime
  inicio_janela     DateTime?
  fim_janela        DateTime?
  score             Float?
  classificacao     String?
  justificativa     String?
  modelo_versao     String?

  talhao_cultura Talhao_Cultura @relation(fields: [talhao_cultura_id], references: [id])
}

model Colheita {
  id                  Int       @id @default(autoincrement())
  talhao_cultura_id   Int
  data_prevista       DateTime?
  data_realizada      DateTime?
  quantidade_prevista Float?
  quantidade_colhida  Float?
  unidade_medida      String?
  status              String

  talhao_cultura      Talhao_Cultura       @relation(fields: [talhao_cultura_id], references: [id])
  operacoes_logistica Operacao_Logistica[]
}

model Operacao_Logistica {
  id                   Int       @id @default(autoincrement())
  empresa_id           Int
  colheita_id          Int
  origem               String
  destino              String
  modal                String
  transportadora       String?
  data_prevista        DateTime?
  tempo_estimado_horas Float?
  custo_estimado       Float?
  status               String

  empresa  Empresa  @relation(fields: [empresa_id], references: [id])
  colheita Colheita @relation(fields: [colheita_id], references: [id])
}

model Dispositivo {
  id              Int       @id @default(autoincrement())
  talhao_id       Int
  codigo          String    @unique
  modelo          String
  status          String
  data_instalacao DateTime?

  talhao   Talhao   @relation(fields: [talhao_id], references: [id])
  sensores Sensor[]
}

model Sensor {
  id             Int    @id @default(autoincrement())
  dispositivo_id Int
  tipo           String
  unidade_medida String
  status         String

  dispositivo Dispositivo @relation(fields: [dispositivo_id], references: [id])
  medicoes    Medicao[]

  // Índice para agilizar buscas de sensores por dispositivo
  @@index([dispositivo_id])
}

model Medicao {
  id             Int      @id @default(autoincrement())
  sensor_id      Int      // O dispositivo é agora inferido através do sensor
  data_hora      DateTime
  temperatura    Float?
  umidade        Float?
  umidade_solo   Float?
  luminosidade   Float?
  precipitacao   Float?

  sensor  Sensor   @relation(fields: [sensor_id], references: [id])
  alertas Alerta[]

  // Índice composto essencial para séries temporais por sensor
  @@index([sensor_id, data_hora])
}

model Alerta {
  id          Int      @id @default(autoincrement())
  medicao_id  Int
  tipo        String
  nivel       String
  titulo      String
  descricao   String?
  data_hora   DateTime
  visualizado Boolean  @default(false)
  status      String

  medicao Medicao @relation(fields: [medicao_id], references: [id])
}