# Exemplo sem credenciais reais. Não substitua o .env compartilhado automaticamente.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/valevivo"
# Opcional: use uma role privilegiada somente para executar migrations.
MIGRATIONS_DATABASE_URL=""
JWT_SECRET="substitua-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="1h"
JWT_ISSUER="sivale-api"
JWT_AUDIENCE="sivale-frontend"
PORT=3000
TRUST_PROXY_HOPS=0
# Rate limit distribuído no PostgreSQL compartilhado (fail-closed se indisponível).
LOGIN_RATE_MAX_ATTEMPTS=5
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_BLOCK_MS=900000
# No Render, definir NODE_ENV=production e CORS_ORIGINS com os domínios do frontend.
# URLs separadas por vírgula, sem caminho. Não usar *.
# Fora de produção, localhost:3000, :5173 e :5174 são permitidos automaticamente.
CORS_ORIGINS=""
# Provisionamento individual pelo comando npm run device:credential; nunca pela API.
# No simulador, use DEVICE_TOKEN_ESP32_TALHAO_01 e DEVICE_TOKEN_SEN_TH_02.
DEVICE_TOKEN_ESP32_TALHAO_01=""
DEVICE_TOKEN_SEN_TH_02=""
# Chave global legada: habilite somente para transição, vinculada a um único device ID.
DEVICE_API_KEY_LEGACY_ENABLED=false
DEVICE_API_KEY=""
DEVICE_API_KEY_LEGACY_DEVICE_ID=""
SIMULATOR_LEGACY_DEVICE_CODE=""
THINGSPEAK_SENSOR_ID=1
THINGSPEAK_CHANNEL_ID=""
THINGSPEAK_WRITE_API_KEY=""
THINGSPEAK_READ_API_KEY=""

# E7 / Etapa A. Vazio desliga todas as fontes: MERCADO_FONTES_ATIVAS=""
MERCADO_FONTES_ATIVAS=comexstat
MERCADO_CACHE_TTL_MIN=60
MERCADO_HTTP_TIMEOUT_MS=10000
# IDs confirmados na própria API Comex Stat: PE=26, BA=32 (não o código IBGE 29).
# Vazio consulta o Brasil inteiro.
COMEXSTAT_ESTADOS=26,32
# Últimos 12 meses completos, excluindo o mês corrente; máximo 24.
COMEXSTAT_MESES=12
