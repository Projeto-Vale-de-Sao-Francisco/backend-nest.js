# Exemplo sem credenciais reais. Não substitua o .env compartilhado automaticamente.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/valevivo"
JWT_SECRET="substitua-por-uma-chave-aleatoria-longa"
JWT_EXPIRES_IN="1h"
PORT=3000
# No Render, definir NODE_ENV=production e CORS_ORIGINS com os domínios do frontend.
# URLs separadas por vírgula, sem caminho. Não usar *.
# Fora de produção, localhost:3000, :5173 e :5174 são permitidos automaticamente.
CORS_ORIGINS=""
DEVICE_API_KEY="substitua-por-uma-chave-local"
THINGSPEAK_SENSOR_ID=1

# E7 / Etapa A. Vazio desliga todas as fontes: MERCADO_FONTES_ATIVAS=""
MERCADO_FONTES_ATIVAS=comexstat
MERCADO_CACHE_TTL_MIN=60
MERCADO_HTTP_TIMEOUT_MS=10000
# IDs confirmados na própria API Comex Stat: PE=26, BA=32 (não o código IBGE 29).
# Vazio consulta o Brasil inteiro.
COMEXSTAT_ESTADOS=26,32
# Últimos 12 meses completos, excluindo o mês corrente; máximo 24.
COMEXSTAT_MESES=12
